# ==============================================================
# WHATSAPP DIGITAL TWIN AI - ENVIRONMENT CONFIGURATION
# Copy this file to .env and insert your API keys & credentials.
# ==============================================================

# 1. Primary AI Engine (NVIDIA NIM - Fast & Free)
# Get your free key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# 2. Secondary AI Engine (OpenAI / OpenRouter / xKiro)
# Compatible with any OpenAI-compatible standard endpoint
OPENAI_API_KEY=your_secondary_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Cloudflare KV Edge Memory (Long-term Contact Dossiers)
# Free 100,000 reads/day at https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_NAMESPACE_ID=your_cloudflare_kv_namespace_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# 4. OpenRouter Alternative (Free Gemma 26B & Free Tier)
# Get your free key at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 5. Regional & Timezone Configuration
# Examples: America/New_York, Europe/London, Asia/Kolkata, Asia/Dubai
BOT_TIMEZONE=UTC
BOT_OWNER_NAME=Alex
